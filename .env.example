# ========================================================
# GOOD FILLS — ENVIRONMENT CONFIGURATION
# ========================================================

# Razorpay API Credentials
# Get your Test or Live Keys from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId

# Server-Only Secret (Never prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret

# Razorpay Webhook Secret configured in your Razorpay Dashboard
# URL: https://yourdomain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Optional: set to 'false' to disable mock simulator in development
NEXT_PUBLIC_MOCK_PAYMENT_MODE=auto
